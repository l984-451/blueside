# Settings for one machine. Copy to site.env beside the scripts and uncomment what differs.
# Each line shows the default. A value set here wins over the environment.

# On the server: run.sh, nav-run.sh and wx-run.sh.
# Folder for work files, logs, the lock and state.
#CHARTPIPE_HOME=/srv/chartpipe
# Credentials file passed to docker --env-file.
#CHARTPIPE_ENV=/srv/chartpipe/r2.env
# Command run when a job needs a person, given a subject and a detail text. May carry arguments. Empty: none.
#CHARTPIPE_NOTIFY=

# On the server: watch.sh.
# Public address of the bucket the apps read; the weather index is fetched from it. Required: without it watch.sh alerts.
#CHARTPIPE_PUBLIC_URL=

# On a developer machine: remote.sh.
# The server ssh address. Required, here or in the environment.
#CHARTPIPE_HOST=
# Folder on the server for the synced source and the work files.
#CHARTPIPE_REMOTE_HOME=/srv/chartpipe
# Credentials file on the server, used by publish.
#CHARTPIPE_REMOTE_ENV=/srv/chartpipe/r2.env
